# Copy to .env and edit. Used by both `docker compose` and local development.

# ---------- Docker (docker compose up -d --build) ----------
# Public hostname that points at your server (used for the HTTPS certificate).
# Leave as "localhost" to test on your own machine.
API_DOMAIN=localhost

# Database password. Use letters and digits only (it is placed inside a connection URL).
POSTGRES_PASSWORD=change-me-db-password

# Set to true for the FIRST start to load the admin user, categories, sample products and coupons.
# The seed is safe to repeat, but set it back to false afterwards.
RUN_SEED=false
# Also create the public demo customer (customer@boutique.pk / Customer@12345). Leave false in production.
SEED_DEMO_CUSTOMER=false

# ---------- Both ----------
# Long random strings, e.g. run: openssl rand -hex 32
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Exact origins of your storefront and admin panel (no trailing slash). Needed for CORS.
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

FREE_SHIPPING_THRESHOLD=5000
FLAT_SHIPPING=250

# Admin account created by the seed.
ADMIN_EMAIL=admin@boutique.pk
ADMIN_PASSWORD=change-me-admin-password

# ---------- Local development only (npm run start:dev, without Docker) ----------
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boutique?schema=public"
